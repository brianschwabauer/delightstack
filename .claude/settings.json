{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\""
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(pnpm format:*)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm typecheck:*)",
			"Bash(pnpm check:*)",
			"Bash(pnpm exec oxfmt:*)",
			"Bash(pnpm exec oxlint:*)",
			"Bash(pnpm exec tsgo:*)"
		]
	}
}
