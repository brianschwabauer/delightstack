---
// Lucide-style icons (24x24, stroke). The built-in Starlight icon set is too
// small to give each category a distinct, meaningful glyph, so we keep a tiny
// curated map here instead.
const icons = {
	actions: [
		'<path d="M14 4.1 12 6"/>',
		'<path d="m5.1 8-2.9-.8"/>',
		'<path d="m6 12-1.9 2"/>',
		'<path d="M7.2 2.2 8 5.1"/>',
		'<path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z"/>',
	],
	display: [
		'<rect width="7" height="9" x="3" y="3" rx="1"/>',
		'<rect width="7" height="5" x="14" y="3" rx="1"/>',
		'<rect width="7" height="9" x="14" y="12" rx="1"/>',
		'<rect width="7" height="5" x="3" y="16" rx="1"/>',
	],
	feedback: [
		'<path d="M10.268 21a2 2 0 0 0 3.464 0"/>',
		'<path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>',
	],
	form: [
		'<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>',
		'<path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>',
	],
	media: [
		'<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>',
		'<circle cx="9" cy="9" r="2"/>',
		'<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
	],
	navigation: [
		'<path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/>',
		'<circle cx="12" cy="12" r="10"/>',
	],
};

interface Props {
	title: string;
	href: string;
	icon: keyof typeof icons;
}

const { title, href, icon } = Astro.props;
---

<a class="ds-category not-content" href={href}>
	<span class="ds-category-icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" set:html={icons[icon].join('')} />
	</span>
	<span class="ds-category-title">{title}</span>
	<span class="ds-category-body"><slot /></span>
	<svg class="ds-category-arrow" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	</svg>
</a>

<style>
	.ds-category {
		--accent: var(--sl-color-accent);
		--accent-low: var(--sl-color-accent-low);

		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas:
			'icon title arrow'
			'icon body  body';
		column-gap: 1rem;
		row-gap: 0.5rem;
		padding: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-black);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s var(--ease-out-3, ease),
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.ds-category:nth-child(6n + 1) {
		--accent: var(--sl-color-orange);
		--accent-low: var(--sl-color-orange-low);
	}
	.ds-category:nth-child(6n + 2) {
		--accent: var(--sl-color-purple);
		--accent-low: var(--sl-color-purple-low);
	}
	.ds-category:nth-child(6n + 3) {
		--accent: var(--sl-color-green);
		--accent-low: var(--sl-color-green-low);
	}
	.ds-category:nth-child(6n + 4) {
		--accent: var(--sl-color-red);
		--accent-low: var(--sl-color-red-low);
	}
	.ds-category:nth-child(6n + 5) {
		--accent: var(--sl-color-blue);
		--accent-low: var(--sl-color-blue-low);
	}

	.ds-category-icon {
		grid-area: icon;
		align-self: start;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.6rem;
		border: 1px solid color-mix(in oklch, var(--accent) 55%, transparent);
		background: var(--accent-low);
		color: var(--accent);
	}

	.ds-category-icon svg {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ds-category-title {
		grid-area: title;
		align-self: center;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		line-height: 1.2;
		color: var(--sl-color-white);
	}

	.ds-category-body {
		grid-area: body;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}

	.ds-category-arrow {
		grid-area: arrow;
		align-self: start;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			transform 0.2s var(--ease-out-3, ease),
			stroke 0.2s ease;
	}

	.ds-category:hover {
		transform: translateY(-3px);
		border-color: color-mix(in oklch, var(--accent) 55%, var(--sl-color-gray-5));
		background: color-mix(in oklch, var(--accent) 6%, var(--sl-color-black));
		box-shadow: 0 14px 30px -14px color-mix(in oklch, var(--accent) 45%, transparent);
	}

	.ds-category:hover .ds-category-arrow {
		transform: translateX(4px);
		stroke: var(--accent);
	}

	.ds-category:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ds-category,
		.ds-category-arrow {
			transition: border-color 0.2s ease, background 0.2s ease;
		}
		.ds-category:hover {
			transform: none;
		}
		.ds-category:hover .ds-category-arrow {
			transform: none;
		}
	}
</style>
