---
import { Button } from '@delightstack/components/actions';
// Inline the wordmark SVG as a raw string at build time. `?raw` is resolved by
// Vite during the build, so it works in static/SSR generation — unlike a runtime
// readFileSync, which can't find src assets relative to the bundled output chunk.
import logoRaw from '../assets/delightstack_logo_adaptive.svg?raw';

const features = ['55 components', 'Edge-native backend', 'Built for Cloudflare', 'Fully typed'];

// Inlining the SVG (vs. <img>) is what lets the text's `currentColor` follow the
// theme. The icon keeps its gradient; the text colour is driven by the CSS below
// (white in dark, deep teal in light).
const logo = logoRaw.slice(logoRaw.indexOf('<svg')).replace(/ id="Artboard2"/g, '');
---

<section class="ds-hero not-content">
	<div class="glow" aria-hidden="true"></div>

	<h1 id="_top" class="title">
		<span class="sr-only">DelightStack</span>
		<span class="logo" aria-hidden="true" set:html={logo}></span>
	</h1>

	<p class="tagline">
		Svelte&nbsp;5 components and an edge-native Cloudflare backend — auth, database, realtime, AI,
		billing, and images. Two products, one design language. Use either, or both.
	</p>

	<div class="actions">
		<Button href="/getting-started/introduction/" client:load>
			Get Started
			<svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M5 12h14m-6-6 6 6-6 6" />
			</svg>
		</Button>
		<Button href="/components/overview/" outline client:load>
			<svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M12 6.5C10.5 5 8.5 4.5 6 4.5c-1 0-2 .1-3 .4v13.6c1-.3 2-.4 3-.4 2.5 0 4.5.5 6 2 1.5-1.5 3.5-2 6-2 1 0 2 .1 3 .4V4.9c-1-.3-2-.4-3-.4-2.5 0-4.5.5-6 2Zm0 0v13.6"
				/>
			</svg>
			Browse Components
		</Button>
	</div>

	<ul class="features">
		{
			features.map((feature) => (
				<li class="feature">
					<svg class="feature-check" viewBox="0 0 24 24" aria-hidden="true">
						<path d="m5 13 4 4L19 7" />
					</svg>
					{feature}
				</li>
			))
		}
	</ul>
</section>

<style>
	.ds-hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 3.5rem);
		overflow: clip;
	}

	/* Soft brand-coloured glow behind the hero. */
	.glow {
		position: absolute;
		z-index: -1;
		inset-block-start: -20%;
		inset-inline-start: 50%;
		width: min(64rem, 130%);
		aspect-ratio: 2 / 1;
		transform: translateX(-50%);
		background: radial-gradient(
			50% 50% at 50% 50%,
			color-mix(in oklch, var(--color-primary, #1f93d4) 38%, transparent),
			transparent 70%
		);
		filter: blur(40px);
		opacity: 0.55;
		pointer-events: none;
	}

	.title {
		margin: 0;
		display: flex;
		justify-content: center;
		width: 100%;
	}

	/* Accessible heading text for screen readers / SEO; the visible wordmark is
	   the inlined SVG below it. */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/* The wordmark's icon keeps its gradient; the text uses currentColor.
	   Default (Starlight's root = dark theme) -> white text. */
	.logo {
		display: block;
		width: min(34rem, 86vw);
		color: #ffffff;
	}
	.logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
	/* Light theme -> deep teal text (in the icon's hue, softer than pure black).
	   Mirrors Starlight's own light-theme resolution (explicit + auto/no-JS). */
	@media (prefers-color-scheme: light) {
		:global(:root:not([data-theme='dark'])) .logo {
			color: #0e4a59;
		}
	}
	:global([data-theme='light']) .logo {
		color: #0e4a59;
	}

	.tagline {
		margin: 0;
		max-width: 48ch;
		font-size: clamp(1rem, 1.6vw, 1.25rem);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		justify-content: center;
		margin-top: 0.25rem;
	}

	/* Inline icons slotted into the delightstack Buttons. Sized in em so they
	   track the button's font size; stroke inherits the button text color. */
	.btn-icon {
		width: 1.2em;
		height: 1.2em;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.features {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.25rem;
		justify-content: center;
	}

	.feature {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.feature-check {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		fill: none;
		stroke: var(--color-success, #00b7a1);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
