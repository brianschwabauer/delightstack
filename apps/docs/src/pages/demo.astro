---
import DashboardDemo from '../components/DashboardDemo.svelte';
// Design tokens + base styles come from the shared package — the single source
// of truth every delightstack app imports. Tokens live on `html`, so portaled
// components (Modal, CommandPalette, Toaster, Alert) keep them on <body>.
import '@delightstack/styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Dashboard Demo – DelightStack</title>
		<style is:global>
			html,
			body {
				height: 100%;
			}
			/* The shared base styles default body copy to the serif display face;
			   a dashboard reads better in the sans stack. */
			body {
				font-family: var(--font-sans);
				-webkit-font-smoothing: antialiased;
			}
		</style>
	</head>
	<body>
		<DashboardDemo client:load />
	</body>
</html>
