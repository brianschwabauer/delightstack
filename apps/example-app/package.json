{
	"name": "@delightstack/example-app",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"build:ci": "vite build --mode $VITE_MODE",
		"deploy": "wrangler deploy .svelte-kit/cloudflare/_worker.js --name example-app --assets .svelte-kit/cloudflare --compatibility-date 2025-02-14",
		"package": "vite package",
		"preview": "vite preview",
		"test": "vitest",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251120.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.48.6",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/cookie": "^0.4.1",
		"@typescript-eslint/eslint-plugin": "^8.47.0",
		"@typescript-eslint/parser": "^8.47.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.0",
		"svelte": "^5.43.13",
		"typescript": "^5.9.3",
		"unplugin-icons": "^22.5.0",
		"vite": "^7.2.4",
		"vitest": "^4.0.12",
		"wrangler": "^4.49.1"
	},
	"dependencies": {
		"@sentry/browser": "^10.26.0",
		"comlink": "^4.4.2",
		"cookie": "^0.4.2",
		"zod": "^4.1.12"
	}
}
