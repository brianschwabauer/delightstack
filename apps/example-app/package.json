{
	"name": "@delightstack/example-app",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "turbo run dev:svelte dev:worker",
		"dev:svelte": "vite dev --port 5174",
		"dev:worker": "cd server && wrangler dev --config wrangler.toml --env staging --persist-to ./../.wrangler/state",
		"build": "vite build",
		"build:ci": "vite build --mode $VITE_MODE",
		"deploy": "wrangler deploy --env production",
		"deploy:staging": "wrangler deploy --env staging",
		"package": "vite package",
		"preview": "vite preview",
		"test": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260401.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/cookie": "^0.4.1",
		"svelte": "^5.55.1",
		"typescript": "^5.9.3",
		"unplugin-icons": "^22.5.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.2",
		"wrangler": "^4.79.0"
	},
	"dependencies": {
		"@delightstack/ai": "workspace:*",
		"@delightstack/auth": "workspace:*",
		"@delightstack/components": "workspace:*",
		"@delightstack/database": "workspace:*",
		"@delightstack/images": "workspace:*",
		"@delightstack/rate-limiter": "workspace:*",
		"@delightstack/stripe": "workspace:*",
		"@delightstack/utilities": "workspace:*",
		"@delightstack/websocket": "workspace:*",
		"comlink": "^4.4.2",
		"zod": "^4.3.6"
	}
}
