{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "92cb4bb9b2a55d24f5688f2f61864079",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"observability": {
		"enabled": true,
	},
	"placement": {
		"mode": "smart",
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"env": {
		"staging": {
			"name": "app-staging",
			"vars": {
				"VITE_MODE": "staging",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "staging.show.tours",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
				{
					"pattern": "staging.show.tours/*",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"kv_namespaces": [
				{
					"binding": "BASE64",
					"id": "9b606a5704fa44cfb31d5d81233358dd",
				},
				{
					"binding": "ENV",
					"id": "af9fee32751a4a3ebecbef2ed705d6dc",
				},
				{
					"binding": "KV",
					"id": "86ebc1140b43484cb9c22a81ba6ced40",
				},
			],
			"services": [
				{
					"binding": "IMAGE_PROCESSOR",
					"service": "image-processor-staging",
				},
				{
					"binding": "SELF",
					"service": "app-staging",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "showandtour-staging",
					},
				],
			},
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "showandtour-staging",
				},
			],
		},
		"production": {
			"name": "app",
			"vars": {
				"VITE_MODE": "production",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "next.show.tours",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
				{
					"custom_domain": true,
					"pattern": "host.show.tours",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
				{
					"pattern": "next.show.tours/*",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
				{
					"pattern": "show.tours/*",
					"zone_id": "d85c0738d67381606bcb149a910731c8",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"kv_namespaces": [
				{
					"binding": "BASE64",
					"id": "cca5020095bf476fb966bd06f03dc5ac",
				},
				{
					"binding": "ENV",
					"id": "97f50395d4b24ce792edbe6a8c404525",
				},
				{
					"binding": "KV",
					"id": "30b41582bc6e4c2f8234a567fe5189fc",
				},
			],
			"services": [
				{
					"binding": "IMAGE_PROCESSOR",
					"service": "image-processor",
				},
				{
					"binding": "SELF",
					"service": "app",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [
					{
						"binding": "QUEUE",
						"queue": "showandtour",
					},
				],
			},
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "showandtour",
				},
			],
		},
	},
}
