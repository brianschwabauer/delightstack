{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "92cb4bb9b2a55d24f5688f2f61864079",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"observability": {
		"enabled": true,
	},
	"placement": {
		"mode": "smart",
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"env": {
		"staging": {
			"name": "delightstack-example-staging",
			"vars": {
				"VITE_MODE": "staging",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "staging.example.thedelight.co",
					"zone_id": "86f43705a221a54f78c507da848063fb",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			// The Durable Object classes live in the server worker
			// (delightstack-example-server-staging); the SvelteKit worker reaches
			// them cross-script via `script_name`, so the server must deploy first.
			"durable_objects": {
				"bindings": [
					{
						"name": "AUTH",
						"class_name": "AuthDatabaseServer",
						"script_name": "delightstack-example-server-staging",
					},
					{
						"name": "DB",
						"class_name": "OrgDatabaseServer",
						"script_name": "delightstack-example-server-staging",
					},
					{
						"name": "WS",
						"class_name": "AppWebsocketServer",
						"script_name": "delightstack-example-server-staging",
					},
					{
						"name": "RATE_LIMITER",
						"class_name": "RateLimiterServer",
						"script_name": "delightstack-example-server-staging",
					},
				],
			},
			"kv_namespaces": [{ "binding": "KV", "id": "19098fe743e642bc825b946e11d30a7c" }],
			"r2_buckets": [{ "binding": "R2", "bucket_name": "delightstack-example-staging" }],
			"services": [
				{
					"binding": "SELF",
					"service": "delightstack-example-staging",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [],
			},
		},
		"production": {
			"name": "delightstack-example",
			"vars": {
				"VITE_MODE": "production",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "example.thedelight.co",
					"zone_id": "86f43705a221a54f78c507da848063fb",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			// The Durable Object classes live in the server worker
			// (delightstack-example-server); the SvelteKit worker reaches them
			// cross-script via `script_name`, so the server must deploy first.
			"durable_objects": {
				"bindings": [
					{
						"name": "AUTH",
						"class_name": "AuthDatabaseServer",
						"script_name": "delightstack-example-server",
					},
					{
						"name": "DB",
						"class_name": "OrgDatabaseServer",
						"script_name": "delightstack-example-server",
					},
					{
						"name": "WS",
						"class_name": "AppWebsocketServer",
						"script_name": "delightstack-example-server",
					},
					{
						"name": "RATE_LIMITER",
						"class_name": "RateLimiterServer",
						"script_name": "delightstack-example-server",
					},
				],
			},
			"kv_namespaces": [{ "binding": "KV", "id": "86eb734b0be94ef6bd522185e1ef9e42" }],
			"r2_buckets": [{ "binding": "R2", "bucket_name": "delightstack-example" }],
			"services": [
				{
					"binding": "SELF",
					"service": "delightstack-example",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [],
			},
		},
	},
}
