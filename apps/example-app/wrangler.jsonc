{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "92cb4bb9b2a55d24f5688f2f61864079",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-05-08",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"observability": {
		"enabled": true,
	},
	"placement": {
		"mode": "smart",
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"env": {
		"staging": {
			"name": "app-staging",
			"vars": {
				"VITE_MODE": "staging",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "staging.example.com",
					"zone_id": "ZONE_ID",
				},
				{
					"pattern": "staging.example.com/*",
					"zone_id": "ZONE_ID",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"kv_namespaces": [
				{ "binding": "KV", "id": "dev-kv" },
			],
			"r2_buckets": [
				{ "binding": "R2", "bucket_name": "dev-r2" },
			],
			"services": [
				{
					"binding": "SELF",
					"service": "app-staging",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [],
			},
		},
		"production": {
			"name": "app",
			"vars": {
				"VITE_MODE": "production",
				"NODE_OPTIONS": "--max-old-space-size=8192",
			},
			"routes": [
				{
					"custom_domain": true,
					"pattern": "example.com",
					"zone_id": "ZONE_ID",
				},
				{
					"pattern": "example.com/*",
					"zone_id": "ZONE_ID",
				},
			],
			"ai": {
				"binding": "AI",
			},
			"browser": {
				"binding": "BROWSER",
			},
			"kv_namespaces": [],
			"r2_buckets": [],
			"services": [
				{
					"binding": "SELF",
					"service": "app",
				},
			],
			"queues": {
				"consumers": [],
				"producers": [],
			},
		},
	},
}
