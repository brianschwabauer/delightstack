{
	"name": "@delightstack/site",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"deploy": "wrangler deploy",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
	},
	"devDependencies": {
		"@iconify/json": "^2.2.362",
		"@sveltejs/adapter-cloudflare": "^7.1.1",
		"@sveltejs/kit": "^2.26.0",
		"@sveltejs/vite-plugin-svelte": "6.1.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"unplugin-icons": "^22.1.0",
		"vite": "^6.3.5"
	},
	"dependencies": {
		"@delightstack/components": "workspace:*",
		"@delightstack/utilities": "workspace:*"
	}
}
