{
	"name": "delightstack",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"license": "MIT",
	"exports": {
		"./components": "./packages/components/dist/index.js",
		"./components/*": "./packages/components/dist/*"
	},
	"scripts": {
		"build": "turbo run build",
		"build:ci": "turbo run build --filter=./apps/app --filter=!@packages/api",
		"test": "turbo run test --parallel",
		"dev": "turbo run dev --parallel --filter=./apps/site --filter=./packages/components --filter=./packages/utilities",
		"dev-docs": "turbo run dev --parallel --filter=./apps/docs --filter=./packages/components",
		"lint": "turbo run lint"
	},
	"packageManager": "pnpm@9.11.0",
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"@cloudflare/workers-types": "^4.20250724.0",
		"@sveltejs/kit": "^2.20.7",
		"@types/google.maps": "^3.58.1",
		"@types/intercom-web": "^2.8.26",
		"@types/jest": "^29.5.14",
		"@typescript-eslint/eslint-plugin": "^8.18.1",
		"@typescript-eslint/parser": "^8.18.1",
		"dotenv": "^10.0.0",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"lint-staged": "^14.0.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.28.2",
		"turbo": "latest",
		"typescript": "^5.7.2",
		"vite": "^6.0.5",
		"vitest": "^3.0.0-beta.3",
		"wrangler": "^4.26.0"
	},
	"lint-staged": {
		"*.{ts,svelte,js,css,md}": "prettier --write --plugin-search-dir=."
	}
}
