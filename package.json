{
	"name": "delightstack",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"license": "MIT",
	"exports": {
		"./components": "./packages/components/dist/index.js",
		"./components/*": "./packages/components/dist/*"
	},
	"scripts": {
		"build": "turbo run build",
		"build:ci": "turbo run build --filter=./apps/app --filter=!@packages/api",
		"test": "turbo run test --parallel",
		"dev": "turbo run dev --parallel --filter=./apps/site --filter=./packages/components --filter=./packages/utilities",
		"dev:example": "turbo run dev:svelte dev:worker --filter=@delightstack/example-app",
		"dev:docs": "turbo run dev --parallel --filter=./apps/docs --filter=./packages/components --filter=./packages/utilities",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "turbo run typecheck",
		"check": "turbo run check"
	},
	"packageManager": "pnpm@9.11.0",
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"@cloudflare/workers-types": "^4.20250724.0",
		"@sveltejs/kit": "^2.20.7",
		"@types/google.maps": "^3.58.1",
		"@types/intercom-web": "^2.8.26",
		"@types/jest": "^29.5.14",
		"@typescript/native-preview": "7.0.0-dev.20260603.1",
		"dotenv": "^10.0.0",
		"oxfmt": "^0.53.0",
		"oxlint": "^1.68.0",
		"svelte": "^5.28.2",
		"turbo": "latest",
		"typescript": "^5.7.2",
		"vite": "^6.0.5",
		"vitest": "^3.0.0-beta.3",
		"wrangler": "^4.26.0"
	}
}
