{
	"name": "@delightstack/ai",
	"version": "1.1.7",
	"type": "module",
	"license": "MIT",
	"description": "AI helpers for Cloudflare Workers — embeddings, AI Gateway, and a reactive streaming client built on the Delightstack database and websocket layers.",
	"keywords": [
		"ai",
		"embeddings",
		"llm",
		"ai-gateway",
		"cloudflare",
		"workers",
		"rag",
		"svelte",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/ai"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"svelte": "./dist/client/index.js",
			"import": "./dist/client/index.js"
		},
		"./schema": {
			"types": "./dist/schema/schema.d.ts",
			"import": "./dist/schema/schema.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "tsgo --noEmit",
		"typecheck": "tsgo --noEmit"
	},
	"peerDependencies": {
		"svelte": "^5.36.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@delightstack/database": "workspace:*",
		"@delightstack/utilities": "workspace:*",
		"@delightstack/websocket": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251120.0",
		"@sveltejs/package": "^2.4.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.1"
	}
}
