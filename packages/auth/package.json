{
	"name": "@delightstack/auth",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"description": "Edge-native authentication for Cloudflare Workers — JWT sessions, Argon2id password hashing, OAuth, passkeys (WebAuthn), and SvelteKit guards, backed by Durable Objects.",
	"keywords": [
		"auth",
		"authentication",
		"jwt",
		"oauth",
		"passkey",
		"webauthn",
		"argon2",
		"cloudflare",
		"workers",
		"durable-objects",
		"sveltekit",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/auth"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./worker": {
			"types": "./dist/worker/index.d.ts",
			"import": "./dist/worker/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"svelte": "./dist/client/index.js",
			"import": "./dist/client/index.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"import": "./dist/sveltekit/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "tsgo --noEmit",
		"test": "vitest"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.36.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@delightstack/database": "workspace:*",
		"@delightstack/utilities": "workspace:*",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"argon2-wasm-edge": "^1.0.23",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251120.0",
		"@edge-runtime/vm": "^5.0.0",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/package": "^2.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.53.3",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.1"
	}
}
