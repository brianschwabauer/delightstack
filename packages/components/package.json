{
	"name": "@delightstack/components",
	"version": "1.5.0",
	"type": "module",
	"license": "MIT",
	"description": "Delightstack Svelte 5 component library — accessible actions, forms, media, navigation, feedback, and display components.",
	"keywords": [
		"svelte",
		"components",
		"ui",
		"ui-library",
		"svelte5",
		"accessible",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/components"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"svelte": "./dist/actions/index.js",
			"import": "./dist/actions/index.js"
		},
		"./display": {
			"types": "./dist/display/index.d.ts",
			"svelte": "./dist/display/index.js",
			"import": "./dist/display/index.js"
		},
		"./feedback": {
			"types": "./dist/feedback/index.d.ts",
			"svelte": "./dist/feedback/index.js",
			"import": "./dist/feedback/index.js"
		},
		"./form": {
			"types": "./dist/form/index.d.ts",
			"svelte": "./dist/form/index.js",
			"import": "./dist/form/index.js"
		},
		"./media": {
			"types": "./dist/media/index.d.ts",
			"svelte": "./dist/media/index.js",
			"import": "./dist/media/index.js"
		},
		"./media/Carousel.svelte": {
			"svelte": "./dist/media/Carousel.svelte",
			"import": "./dist/media/Carousel.svelte"
		},
		"./media/Gallery.svelte": {
			"svelte": "./dist/media/Gallery.svelte",
			"import": "./dist/media/Gallery.svelte"
		},
		"./media/Image.svelte": {
			"svelte": "./dist/media/Image.svelte",
			"import": "./dist/media/Image.svelte"
		},
		"./media/Video.svelte": {
			"svelte": "./dist/media/Video.svelte",
			"import": "./dist/media/Video.svelte"
		},
		"./pdf": {
			"svelte": "./dist/media/PDF.svelte",
			"import": "./dist/media/PDF.svelte"
		},
		"./panorama": {
			"svelte": "./dist/media/Panorama.svelte",
			"import": "./dist/media/Panorama.svelte"
		},
		"./navigation": {
			"types": "./dist/navigation/index.d.ts",
			"svelte": "./dist/navigation/index.js",
			"import": "./dist/navigation/index.js"
		}
	},
	"bin": {
		"delightstack-agents": "./bin/agents.js"
	},
	"files": [
		"bin",
		"SKILL.md",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.26.0",
		"@sveltejs/package": "^2.4.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"unplugin-icons": "^22.1.0",
		"vite": "^6.3.5"
	},
	"dependencies": {
		"@delightstack/utilities": "workspace:*",
		"thumbhash": "^0.1.1"
	},
	"peerDependencies": {
		"@delightstack/styles": "workspace:^",
		"svelte": "^5.36.0",
		"hls.js": ">=1.4.0",
		"pdfjs-dist": ">=4.0.0",
		"three": ">=0.150.0"
	},
	"peerDependenciesMeta": {
		"hls.js": {
			"optional": true
		},
		"pdfjs-dist": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	}
}
