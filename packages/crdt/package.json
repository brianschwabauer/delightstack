{
	"name": "@delightstack/crdt",
	"version": "0.3.0",
	"type": "module",
	"license": "MIT",
	"description": "Collaborative document storage for Cloudflare Durable Objects — a Loro CRDT wrapper with an append-only op log, derived edit sessions, named checkpoints, time travel and compaction.",
	"keywords": [
		"crdt",
		"loro",
		"collaborative-editing",
		"local-first",
		"durable-objects",
		"cloudflare",
		"version-history",
		"time-travel",
		"prosemirror",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/crdt"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"workerd": "./dist/server/index.js",
			"import": "./dist/server/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"svelte": "./dist/client/index.js",
			"import": "./dist/client/index.js"
		},
		"./prosemirror": {
			"types": "./dist/prosemirror/index.d.ts",
			"svelte": "./dist/prosemirror/index.js",
			"import": "./dist/prosemirror/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/__tests__"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "tsgo --noEmit",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run && vitest run --config vitest.workers.config.ts",
		"test:workerd": "vitest run --config vitest.workers.config.ts"
	},
	"dependencies": {
		"@delightstack/utilities": "workspace:*",
		"loro-crdt": "^1.14.1"
	},
	"peerDependencies": {
		"prosemirror-model": "^1.25.0",
		"prosemirror-state": "^1.4.3",
		"svelte": "^5.36.0"
	},
	"peerDependenciesMeta": {
		"prosemirror-model": {
			"optional": true
		},
		"prosemirror-state": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12",
		"@cloudflare/workers-types": "^4.20250724.0",
		"@sveltejs/package": "^2.4.0",
		"@types/node": "^24.1.0",
		"prosemirror-model": "^1.25.0",
		"prosemirror-state": "^1.4.3",
		"prosemirror-transform": "^1.10.4",
		"prosemirror-view": "^1.40.0",
		"svelte": "^5.36.16",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.1"
	}
}
