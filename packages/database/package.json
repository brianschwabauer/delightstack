{
	"name": "@delightstack/database",
	"version": "2.2.5",
	"type": "module",
	"license": "MIT",
	"description": "Reactive SQLite for Cloudflare Durable Objects — typed schema, client/worker sync over Comlink, and a built-in full-text search engine.",
	"keywords": [
		"database",
		"sqlite",
		"durable-objects",
		"cloudflare",
		"workers",
		"search",
		"reactive",
		"sync",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/database"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./worker": {
			"types": "./dist/worker/index.d.ts",
			"import": "./dist/worker/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"svelte": "./dist/client/index.js",
			"import": "./dist/client/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__tests__"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "tsgo --noEmit",
		"typecheck": "tsgo --noEmit",
		"test": "vitest"
	},
	"peerDependencies": {
		"svelte": "^5.36.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@delightstack/utilities": "workspace:*",
		"comlink": "^4.4.2",
		"fast-equals": "^6.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251120.0",
		"@edge-runtime/vm": "^5.0.0",
		"@sveltejs/package": "^2.4.0",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	}
}
