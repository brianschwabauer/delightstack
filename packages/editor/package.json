{
	"name": "@delightstack/editor",
	"version": "0.2.0",
	"type": "module",
	"license": "MIT",
	"description": "A delightful rich text / block editor for Svelte 5 built on ProseMirror — slash commands, drag & drop blocks, magnetic resize, optimistic uploads, and an extensible block system.",
	"keywords": [
		"editor",
		"rich-text",
		"prosemirror",
		"block-editor",
		"wysiwyg",
		"svelte",
		"svelte5",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/editor"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"svelte": "./dist/core/index.js",
			"import": "./dist/core/index.js"
		},
		"./blocks": {
			"types": "./dist/blocks/index.d.ts",
			"svelte": "./dist/blocks/index.js",
			"import": "./dist/blocks/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js",
			"import": "./dist/components/index.js"
		},
		"./render": {
			"types": "./dist/render/index.d.ts",
			"import": "./dist/render/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"dev:svelte": "svelte-package -w -i src",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest"
	},
	"peerDependencies": {
		"@delightstack/components": "workspace:*",
		"svelte": "^5.36.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@delightstack/utilities": "workspace:*",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-gapcursor": "^1.3.2",
		"prosemirror-history": "^1.4.1",
		"prosemirror-inputrules": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.1",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-transform": "^1.10.4",
		"prosemirror-view": "^1.40.0"
	},
	"devDependencies": {
		"@delightstack/components": "workspace:*",
		"@sveltejs/kit": "^2.26.0",
		"@sveltejs/package": "^2.4.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"happy-dom": "^20.10.4",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.1"
	}
}
