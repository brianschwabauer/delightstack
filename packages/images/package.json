{
	"name": "@delightstack/images",
	"version": "1.1.9",
	"type": "module",
	"license": "MIT",
	"description": "Image processing for Cloudflare — on-the-fly variants, face-aware cropping, thumbhash placeholders, and PDF/SVG handling via Cloudflare Containers + Sharp.",
	"keywords": [
		"images",
		"image-processing",
		"sharp",
		"thumbhash",
		"cloudflare",
		"containers",
		"workers",
		"cdn",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/images"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./worker": {
			"types": "./dist/worker.d.ts",
			"import": "./dist/worker.js"
		}
	},
	"files": [
		"dist",
		"container",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"typecheck": "tsgo --noEmit",
		"test": "vitest"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.1.0",
		"@delightstack/database": "workspace:*",
		"@delightstack/utilities": "workspace:*",
		"thumbhash": "^0.1.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251120.0",
		"@sveltejs/package": "^2.4.0",
		"svelte": "^5.36.16",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.1"
	}
}
