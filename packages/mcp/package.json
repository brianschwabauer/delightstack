{
	"name": "@delightstack/mcp",
	"version": "0.2.1",
	"type": "module",
	"license": "MIT",
	"description": "A Model Context Protocol server for Cloudflare Workers — Streamable HTTP transport, a validated tool registry, and an OAuth 2.1 provider with PKCE and dynamic client registration.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"oauth",
		"oauth2",
		"pkce",
		"agents",
		"claude",
		"cloudflare",
		"workers",
		"durable-objects",
		"sveltekit",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/mcp"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"workerd": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"import": "./dist/sveltekit/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/__tests__"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "tsgo --noEmit",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run && vitest run --config vitest.workers.config.ts",
		"test:workerd": "vitest run --config vitest.workers.config.ts"
	},
	"dependencies": {
		"@delightstack/utilities": "workspace:*"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12",
		"@cloudflare/workers-types": "^4.20251120.0",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/package": "^2.4.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.1"
	}
}
