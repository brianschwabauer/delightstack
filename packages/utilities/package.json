{
	"name": "@delightstack/utilities",
	"version": "1.1.0",
	"type": "module",
	"license": "MIT",
	"description": "Framework-agnostic TypeScript utilities for Delightstack — the DelightError error class, reactive Svelte 5 helpers, attachments, and DOM utilities.",
	"keywords": [
		"utilities",
		"error-handling",
		"svelte",
		"reactive",
		"dom",
		"typescript",
		"delightstack"
	],
	"author": "Brian Schwabauer",
	"homepage": "https://docs.thedelight.co",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brianschwabauer/delightstack.git",
		"directory": "packages/utilities"
	},
	"bugs": "https://github.com/brianschwabauer/delightstack/issues",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "tsgo --noEmit",
		"check:watch": "tsgo --noEmit --watch",
		"test": "vitest"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.26.0",
		"@sveltejs/package": "^2.4.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.1"
	},
	"peerDependencies": {
		"svelte": "^5.36.0"
	},
	"dependencies": {
		"@shopify/draggable": "^1.1.3",
		"dequal": "^2.0.3",
		"focus-trap": "^7.6.2",
		"selecto": "^1.26.3",
		"zod": "^4.1.12"
	}
}
