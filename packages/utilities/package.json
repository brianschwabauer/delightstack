{
	"name": "@delightstack/utilities",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"dev": "svelte-package -w -i src",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check ./src && eslint ./src",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ./src"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.26.0",
		"@sveltejs/package": "^2.4.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"svelte": "^5.36.0"
	},
	"dependencies": {
		"@shopify/draggable": "^1.1.3",
		"dequal": "^2.0.3",
		"focus-trap": "^7.6.2",
		"selecto": "^1.26.3",
		"zod": "^4.1.12"
	}
}
