{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".build/**", ".svelte-kit/**", "build/**"],
		},
		"@delightstack/components#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": [],
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
		},
		"dev": {
			"cache": false,
			"persistent": true,
			// `system dev` moves the dev ports with DEV_PORT and lets vite answer
			// on the dev domain; strict env mode would otherwise withhold both.
			"passThroughEnv": ["DEV_PORT", "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS"],
		},
		"dev:svelte": {
			"cache": false,
			"persistent": true,
		},
		"dev:worker": {
			"cache": false,
			"persistent": true,
		},
		"package": {
			"outputs": ["package"],
		},
	},
}
